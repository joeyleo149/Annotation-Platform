{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AnnotationDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "VideoStorage": {
    "VideoDirectory": "Storage/Videos",
    "ThumbnailDirectory": "Storage/Thumbnails",
    "ManifestDirectory": "Storage/Manifests",
    "MaximumFileSizeMb": 500,
    "AllowedExtensions": [
      ".mp4",
      ".avi",
      ".mkv"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}