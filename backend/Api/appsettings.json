{
  "ConnectionStrings": {
  "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=KitScenesAnnotationDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "AnnotatePro.Api",
    "Audience": "AnnotatePro.Client",
    "Key": "development-only-change-this-key-before-production-2026"
  },
  "VideoStorage": {
    "VideoDirectory": "Storage/Videos",
    "ThumbnailDirectory": "Storage/Thumbnails",
    "ManifestDirectory": "Storage/Manifests",
    "MaximumFileSizeMb": 500,
    "MaximumManifestFileSizeMb": 20,
    "ManifestFileName": "train_scenario_manifest.json",
    "AllowedExtensions": [
      ".mp4",
      ".avi",
      ".mkv"
    ]
  },
  "AssignmentProcessing": {
    "CheckIntervalSeconds": 60,
    "DefaultAssignmentDurationDays": 1
  },
  "ArchiveProcessing": {
    "CheckIntervalSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}